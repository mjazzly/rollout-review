	column status_week
		dataType: dateTime
		formatString: Long Date
		lineageTag: 866d708f-efca-4595-9b04-f282ea36c1a2
		summarizeBy: none
		sourceColumn: status_week

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Library items with status retired or merged, counted by the check-in month of their status_week, with merged_into_item_id shown for merged items.
	column status_month =
			LOOKUPVALUE ( dim_week[checkin_month], dim_week[week_start], dim_library_item[status_week] )
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		formatString: \M\o\n\t\h 0

	/// Helper, not in measures.md. Whether the item's latest smaller-tier run is passing, as "Passes" or "Does not pass", for the page 4 colours.
	column smaller_model_result =
			VAR itemId = dim_library_item[item_id]
			VAR latestRun =
			    TOPN (
			        1,
			        FILTER ( fact_test_run, fact_test_run[item_id] = itemId && fact_test_run[model_tier] = "smaller" ),
			        fact_test_run[run_date], DESC,
			        fact_test_run[run_id], DESC
			    )
			RETURN
			    IF ( MAXX ( latestRun, IF ( fact_test_run[passing], 1, 0 ) ) = 1, "Passes", "Does not pass" )
		dataType: string
		isDataTypeInferred
		summarizeBy: none

	partition dim_library_item = m
		mode: import
		source =
				let
				    Source = LoadCsv("dim_library_item"),
				    Typed = Table.TransformColumnTypes(Source, {
				        {"item_id", type text}, {"item_name", type text}, {"category", type text},
				        {"owner_person_id", type text}, {"owner_team", type text}, {"version", Int64.Type},
				        {"limits", type text}, {"answer_key_first", type logical}, {"status", type text},
				        {"merged_into_item_id", type text}, {"published_week", type date}, {"status_week", type date}
				    }, "en-US")
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
