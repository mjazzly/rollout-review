	/// The thresholds are illustrative programme targets. A real programme sets its own; these are here so the tiles can carry a verdict on the synthetic data.
	measure 'Foundation threshold' = "Threshold " & FORMAT ( CALCULATE ( MAX ( dim_threshold[threshold] ), dim_threshold[stage] = "Foundation" ), "0%" )
		lineageTag: 2cc26ce0-2104-4f41-96b8-97baa87612c8

	/// The thresholds are illustrative programme targets. A real programme sets its own; these are here so the tiles can carry a verdict on the synthetic data.
	measure 'Execution threshold' = "Threshold " & FORMAT ( CALCULATE ( MAX ( dim_threshold[threshold] ), dim_threshold[stage] = "Execution" ), "0%" )
		lineageTag: 8ce4a446-44c9-43a7-a1c1-471f12755cf0

	/// The thresholds are illustrative programme targets. A real programme sets its own; these are here so the tiles can carry a verdict on the synthetic data.
	measure 'Refinement threshold' = "Threshold " & FORMAT ( CALCULATE ( MAX ( dim_threshold[threshold] ), dim_threshold[stage] = "Refinement" ), "0%" )
		lineageTag: 64c70474-d177-4ff4-bf30-0250faef9111

	/// The thresholds are illustrative programme targets. A real programme sets its own; these are here so the tiles can carry a verdict on the synthetic data.
	measure 'Scale threshold' =
			"Threshold "
			    & FORMAT ( CALCULATE ( MAX ( dim_threshold[threshold] ), dim_threshold[stage] = "Scale" ), "0" )
			    & " points above baseline"
		lineageTag: 8e076f17-e723-4909-8db9-47da7c3b97cc

	/// People at each checkpoint, per team and check-in month, by check-in placement or by source placement as the page toggle selects.
	measure 'People at checkpoint' =
			VAR m = [Check-in month]
			VAR placement = SELECTEDVALUE ( placement_toggle[placement], "Source" )
			RETURN
			    IF (
			        placement = "Check-in",
			        CALCULATE (
			            COUNTROWS ( fact_placement ),
			            REMOVEFILTERS ( dim_month ),
			            fact_placement[checkin_month] = m
			        ),
			        CALCULATE (
			            COUNTROWS ( fact_placement ),
			            REMOVEFILTERS ( dim_month ),
			            fact_placement[checkin_month] = m,
			            REMOVEFILTERS ( dim_checkpoint ),
			            TREATAS ( VALUES ( dim_checkpoint[checkpoint_id] ), dim_checkpoint_source[checkpoint_id] )
			        )
			    ) + 0
		formatString: #,0
		lineageTag: 2e4c9094-f5e0-437c-b586-4b3c91ff067c

	/// People whose check-in checkpoint_id is higher than their source checkpoint_id in the check-in month.
	measure 'Gap higher' =
			VAR m = [Check-in month]
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_placement ),
			        fact_placement[gap] > 0,
			        REMOVEFILTERS ( dim_month ),
			        fact_placement[checkin_month] = m
			    ) + 0
		formatString: #,0
		lineageTag: 9bc169c9-38e3-4335-a2ef-f8b2fedd1c87

	/// People whose check-in checkpoint_id equals their source checkpoint_id in the check-in month.
	measure 'Gap level' =
			VAR m = [Check-in month]
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_placement ),
			        fact_placement[gap] = 0,
			        REMOVEFILTERS ( dim_month ),
			        fact_placement[checkin_month] = m
			    ) + 0
		formatString: #,0
		lineageTag: 196d0f3f-9529-4d60-9772-1317d749c078

	/// People whose check-in checkpoint_id is lower than their source checkpoint_id in the check-in month.
	measure 'Gap lower' =
			VAR m = [Check-in month]
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_placement ),
			        fact_placement[gap] < 0,
			        REMOVEFILTERS ( dim_month ),
			        fact_placement[checkin_month] = m
			    ) + 0
		formatString: #,0
		lineageTag: f9e0cfd0-6ea9-4dd8-b7c4-63525136bc4d

	/// Moved up, per team.
	measure 'Movement up' = [Moved up]
		formatString: #,0
		lineageTag: 5a015a5b-3100-4c60-92dd-0e7b832ac77a

	/// People who held a seat at both counts and whose source checkpoint_id at the latest count equals the previous count.
	measure 'Movement held' =
			VAR m = [Check-in month]
			VAR previousWeek =
			    CALCULATE ( MAX ( dim_month[checkin_week] ), REMOVEFILTERS ( dim_month ), dim_month[checkin_month] = m - 1 )
			VAR seatedAtBoth =
			    FILTER (
			        dim_person,
			        NOT ISBLANK ( dim_person[seat_assigned_week] )
			            && dim_person[seat_assigned_week] <= previousWeek
			    )
			VAR held =
			    FILTER (
			        seatedAtBoth,
			        VAR latest =
			            CALCULATE ( MAX ( fact_placement[source_checkpoint_id] ), REMOVEFILTERS ( dim_month ), fact_placement[checkin_month] = m )
			        VAR previous =
			            CALCULATE ( MAX ( fact_placement[source_checkpoint_id] ), REMOVEFILTERS ( dim_month ), fact_placement[checkin_month] = m - 1 )
			        RETURN
			            latest = previous
			    )
			RETURN
			    IF ( m >= 2, COUNTROWS ( held ) + 0 )
		formatString: #,0
		lineageTag: ee03fc02-711a-4c1d-b5dc-a106164a2814

	/// People who held a seat at both counts and whose source checkpoint_id at the latest count is lower than at the previous count.
	measure 'Movement down' =
			VAR m = [Check-in month]
			VAR previousWeek =
			    CALCULATE ( MAX ( dim_month[checkin_week] ), REMOVEFILTERS ( dim_month ), dim_month[checkin_month] = m - 1 )
			VAR seatedAtBoth =
			    FILTER (
			        dim_person,
			        NOT ISBLANK ( dim_person[seat_assigned_week] )
			            && dim_person[seat_assigned_week] <= previousWeek
			    )
			VAR movedDown =
			    FILTER (
			        seatedAtBoth,
			        VAR latest =
			            CALCULATE ( MAX ( fact_placement[source_checkpoint_id] ), REMOVEFILTERS ( dim_month ), fact_placement[checkin_month] = m )
			        VAR previous =
			            CALCULATE ( MAX ( fact_placement[source_checkpoint_id] ), REMOVEFILTERS ( dim_month ), fact_placement[checkin_month] = m - 1 )
			        RETURN
			            latest < previous
			    )
			RETURN
			    IF ( m >= 2, COUNTROWS ( movedDown ) + 0 )
		formatString: #,0
		lineageTag: a0811dc9-f8e1-4c52-9fcc-04e6107db3d1

	/// Seats arrived, per team, shown apart from up, held and down.
	measure 'Movement seats arrived' = [Seats arrived]
		formatString: #,0
		lineageTag: 30ff1f8b-d9b2-425e-809b-308fa7e9de43

	/// Per team, the checkpoint with the most people under the placement the page toggle selects, for the check-in month, shown with its lever from dim_checkpoint. A tie goes to the lower checkpoint_id.
	measure 'Largest group' =
			VAR counts =
			    ADDCOLUMNS ( ALL ( dim_checkpoint[checkpoint_id] ), "@people", [People at checkpoint] )
			VAR topRow = TOPN ( 1, counts, [@people], DESC, dim_checkpoint[checkpoint_id], ASC )
			VAR topId = MAXX ( topRow, dim_checkpoint[checkpoint_id] )
			RETURN
			    CALCULATE ( MAX ( dim_checkpoint[checkpoint] ), REMOVEFILTERS ( dim_checkpoint ), dim_checkpoint[checkpoint_id] = topId )
		lineageTag: 8bc99ee0-8e6f-4dac-8f77-61347b192297

	/// Per team, the checkpoint with the most people under the placement the page toggle selects, for the check-in month, shown with its lever from dim_checkpoint. A tie goes to the lower checkpoint_id.
	measure 'Largest group people' =
			VAR counts =
			    ADDCOLUMNS ( ALL ( dim_checkpoint[checkpoint_id] ), "@people", [People at checkpoint] )
			VAR topRow = TOPN ( 1, counts, [@people], DESC, dim_checkpoint[checkpoint_id], ASC )
			RETURN
			    MAXX ( topRow, [@people] )
		formatString: #,0
		lineageTag: bdb7d703-b056-4d98-a1bd-7cc8568392c0

	/// Per team, the checkpoint with the most people under the placement the page toggle selects, for the check-in month, shown with its lever from dim_checkpoint. A tie goes to the lower checkpoint_id.
	measure 'Largest group lever' =
			VAR counts =
			    ADDCOLUMNS ( ALL ( dim_checkpoint[checkpoint_id] ), "@people", [People at checkpoint] )
			VAR topRow = TOPN ( 1, counts, [@people], DESC, dim_checkpoint[checkpoint_id], ASC )
			VAR topId = MAXX ( topRow, dim_checkpoint[checkpoint_id] )
			RETURN
			    CALCULATE ( MAX ( dim_checkpoint[lever] ), REMOVEFILTERS ( dim_checkpoint ), dim_checkpoint[checkpoint_id] = topId )
		lineageTag: f06c8cbb-7c3b-49c1-ae8d-8a4ea1be2136

	/// Questions in each category, ranked from most to fewest.
	measure 'Uses logged and ranked' = COUNTROWS ( fact_question )
		formatString: #,0
		lineageTag: 24d84bf6-1cfa-4f39-b6b0-62cff0f29867

	/// Library items with answer_key_first true, over all library items.
	measure 'Prompts tested against an answer key written first' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( dim_library_item ), dim_library_item[answer_key_first] = TRUE () ) + 0,
			    COUNTROWS ( dim_library_item )
			)
		formatString: 0.0%
		lineageTag: 70585748-3544-4732-ae06-bfe9e3f815c5

	/// Questions with action_taken of pointed to library, over all questions.
	measure 'Requests matched to a tested prompt that already exists' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_question ), fact_question[action_taken] = "pointed to library" ) + 0,
			    COUNTROWS ( fact_question )
			)
		formatString: 0.0%
		lineageTag: a486abce-ed5a-4878-88ed-8d5a5ed96c79

	/// Weekly active share per team, averaged over the four weeks starting with the week the team's seats arrive.
	measure 'Usage baseline by team' =
			IF (
			    HASONEVALUE ( dim_team[team] ),
			    VAR firstWeek = SELECTEDVALUE ( dim_team[seats_arrive_week] )
			    VAR baselineWeeks =
			        CALCULATETABLE (
			            VALUES ( dim_week[week_start] ),
			            REMOVEFILTERS ( dim_month ),
			            REMOVEFILTERS ( dim_week ),
			            dim_week[week_start] >= firstWeek,
			            dim_week[week_start] <= firstWeek + 21
			        )
			    RETURN
			        AVERAGEX (
			            baselineWeeks,
			            VAR wk = dim_week[week_start]
			            RETURN
			                CALCULATE (
			                    [Weekly active share],
			                    REMOVEFILTERS ( dim_month ),
			                    REMOVEFILTERS ( dim_week ),
			                    dim_week[week_start] = wk
			                )
			        )
			)
		formatString: 0.0%
		lineageTag: 73d09471-2c34-424c-ba18-cd1b45bdfcf2

	/// Training attendees with a run of the item shown in their session in the session week or the week after, over all training attendees.
	measure 'First use within two weeks of training' =
			VAR ranShownItem =
			    FILTER (
			        fact_training,
			        VAR personId = fact_training[person_id]
			        VAR itemId = fact_training[item_id_shown]
			        VAR sessionWeek = fact_training[session_week]
			        RETURN
			            CALCULATE (
			                COUNTROWS ( fact_library_run_person ),
			                REMOVEFILTERS ( dim_week ),
			                REMOVEFILTERS ( dim_month ),
			                fact_library_run_person[person_id] = personId,
			                fact_library_run_person[item_id] = itemId,
			                fact_library_run_person[week_start] >= sessionWeek,
			                fact_library_run_person[week_start] <= sessionWeek + 7
			            ) > 0
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( ranShownItem ) + 0, COUNTROWS ( fact_training ) )
		formatString: 0.0%
		lineageTag: 6fddf0c8-a43f-481a-be7a-3930f19185f7

	/// People with another active week starting within 30 days after their first active week, over people whose first active week starts at least 30 days before the end of the period.
	measure 'Repeat use within 30 days' =
			VAR lastMonth = CALCULATE ( MAX ( dim_month[checkin_month] ), REMOVEFILTERS ( dim_month ) )
			RETURN
			    CALCULATE ( [Execution tile], REMOVEFILTERS ( dim_month ), dim_month[checkin_month] = lastMonth )
		formatString: 0.0%
		lineageTag: db07f341-e8ed-4bec-834b-b4d1a9a65600

	/// Questions with repeat_flag true whose category had a live library item in the week they were asked, over all questions with repeat_flag true.
	measure 'Recurring questions covered by a tested prompt' =
			VAR repeatQuestions = FILTER ( fact_question, fact_question[repeat_flag] )
			VAR covered =
			    FILTER (
			        repeatQuestions,
			        VAR questionCategory = fact_question[category]
			        VAR askedWeek = fact_question[question_week]
			        RETURN
			            NOT ISEMPTY (
			                FILTER (
			                    ALL ( dim_library_item ),
			                    dim_library_item[category] = questionCategory
			                        && dim_library_item[published_week] <= askedWeek
			                        && ( ISBLANK ( dim_library_item[status_week] ) || dim_library_item[status_week] > askedWeek )
			                )
			            )
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( covered ) + 0, COUNTROWS ( repeatQuestions ) )
		formatString: 0.0%
		lineageTag: 54e72e21-a4e8-420e-9215-302bc3104588

	/// Live library items whose latest standard-tier run is passing, over all live library items.
	measure 'Tested prompts passing their cases' =
			VAR checkinWeek = [Check-in week]
			VAR checkinDate = [Check-in date]
			VAR liveItems =
			    FILTER (
			        dim_library_item,
			        dim_library_item[published_week] <= checkinWeek
			            && ( ISBLANK ( dim_library_item[status_week] ) || dim_library_item[status_week] > checkinWeek )
			    )
			VAR passingItems =
			    FILTER (
			        liveItems,
			        VAR itemId = dim_library_item[item_id]
			        VAR latestRun =
			            TOPN (
			                1,
			                FILTER (
			                    ALL ( fact_test_run ),
			                    fact_test_run[item_id] = itemId
			                        && fact_test_run[model_tier] = "standard"
			                        && fact_test_run[run_date] <= checkinDate
			                ),
			                fact_test_run[run_date], DESC,
			                fact_test_run[run_id], DESC
			            )
			        RETURN
			            MAXX ( latestRun, IF ( fact_test_run[passing], 1, 0 ) ) = 1
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( passingItems ) + 0, COUNTROWS ( liveItems ) )
		formatString: 0.0%
		lineageTag: 41f2b98c-296e-407a-9d88-8d7981b023b3

	/// Library items whose latest smaller-tier run is passing.
	measure 'Tested prompts that pass on a smaller model' =
			VAR passingItems =
			    FILTER (
			        dim_library_item,
			        VAR itemId = dim_library_item[item_id]
			        VAR latestRun =
			            TOPN (
			                1,
			                FILTER ( ALL ( fact_test_run ), fact_test_run[item_id] = itemId && fact_test_run[model_tier] = "smaller" ),
			                fact_test_run[run_date], DESC,
			                fact_test_run[run_id], DESC
			            )
			        RETURN
			            MAXX ( latestRun, IF ( fact_test_run[passing], 1, 0 ) ) = 1
			    )
			RETURN
			    COUNTROWS ( passingItems ) + 0
		formatString: #,0
		lineageTag: 390e31b8-18f1-4e8c-b5b4-e1f6aec7335f

	/// Median tokens per run, per item and model tier.
	measure 'Cost per use' = MEDIAN ( fact_test_run[tokens_per_run] )
		formatString: #,0
		lineageTag: 1a1f14c9-dca8-45a8-9620-5d5a7c74ae93

	/// Library items with status retired or merged, counted by the check-in month of their status_week, with merged_into_item_id shown for merged items.
	measure 'Prompts retired or merged' =
			COUNTROWS (
			    FILTER (
			        dim_library_item,
			        dim_library_item[status] IN { "retired", "merged" }
			            && dim_library_item[status_month] IN VALUES ( dim_month[checkin_month] )
			    )
			) + 0
		formatString: #,0
		lineageTag: aeca31d0-3193-45c5-afa1-c999ca3c9b4a

	/// Check-in responses per team for each answer to q5_if_gone, for the check-in month.
	measure 'Impact in people''s own words' =
			VAR m = [Check-in month]
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_checkin ),
			        REMOVEFILTERS ( dim_month ),
			        fact_checkin[checkin_month] = m,
			        KEEPFILTERS ( NOT ISBLANK ( fact_checkin[q5_if_gone] ) )
			    )
		formatString: #,0
		lineageTag: 1c32586d-a9b6-4aec-b242-32f68cf767d1

	/// Library items with runs in fact_library_run from 2 or more teams.
	measure 'Uses taken up beyond the first team' =
			COUNTROWS (
			    FILTER (
			        dim_library_item,
			        CALCULATE (
			            DISTINCTCOUNT ( fact_library_run[team] ),
			            REMOVEFILTERS ( dim_team ),
			            REMOVEFILTERS ( dim_week ),
			            REMOVEFILTERS ( dim_month )
			        ) >= 2
			    )
			) + 0
		formatString: #,0
		lineageTag: f787cd38-66a7-4102-a73c-fc9b5d83c0e1

	/// Per library item, the earliest week_start in fact_library_run with runs from a team other than the owner_team.
	measure 'Week the second team started' =
			VAR ownerTeam = SELECTEDVALUE ( dim_library_item[owner_team] )
			VAR firstWeek =
			    CALCULATE (
			        MIN ( fact_library_run[week_start] ),
			        fact_library_run[team] <> ownerTeam,
			        REMOVEFILTERS ( dim_team ),
			        REMOVEFILTERS ( dim_week ),
			        REMOVEFILTERS ( dim_month )
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( ownerTeam ) && NOT ISBLANK ( firstWeek ),
			        CALCULATE ( MAX ( dim_week[week_no] ), REMOVEFILTERS ( dim_week ), REMOVEFILTERS ( dim_month ), dim_week[week_start] = firstWeek )
			    )
		formatString: \W\e\e\k 0
		lineageTag: 768d1952-e934-4519-9db8-e96cf8e4c25a

	/// People with a source checkpoint_id of 7, 8 or 9, over all people in the team, per team, for the latest check-in month and the team's baseline month.
	measure 'Share of people in the air latest' =
			VAR m = [Check-in month]
			RETURN
			    DIVIDE (
			        CALCULATE (
			            COUNTROWS ( fact_placement ),
			            fact_placement[source_checkpoint_id] >= 7,
			            REMOVEFILTERS ( dim_month ),
			            fact_placement[checkin_month] = m
			        ) + 0,
			        COUNTROWS ( dim_person )
			    )
		formatString: 0.0%
		lineageTag: aa820bf4-a7d7-46d6-985e-0d2b7df0a169

	/// People with a source checkpoint_id of 7, 8 or 9, over all people in the team, per team, for the latest check-in month and the team's baseline month.
	measure 'Share of people in the air baseline' =
			VAR airAtBaseline =
			    SUMX (
			        VALUES ( dim_team[team] ),
			        VAR b = CALCULATE ( MAX ( dim_team[baseline_month] ) )
			        RETURN
			            CALCULATE (
			                COUNTROWS ( fact_placement ),
			                fact_placement[source_checkpoint_id] >= 7,
			                REMOVEFILTERS ( dim_month ),
			                fact_placement[checkin_month] = b
			            )
			    )
			RETURN
			    DIVIDE ( airAtBaseline + 0, COUNTROWS ( dim_person ) )
		formatString: 0.0%
		lineageTag: 1ab9cc81-3b7a-4844-bcf0-92d22070a7c8

	/// Helper, not in measures.md. The week label of the selected week, or Week 24 when no week is selected.
	measure 'Selected week label' =
			VAR wk = MAX ( dim_week[week_start] )
			RETURN
			    CALCULATE ( SELECTEDVALUE ( dim_week[week_label] ), dim_week[week_start] = wk )
		lineageTag: dc2ad7df-6c3f-4c6b-8e5a-5a80e1c4670d

	/// Helper, not in measures.md. Headcount, Seats assigned and Seats active this week in one line, for the page 0 header.
	measure 'Header line' =
			FORMAT ( [Headcount], "#,0" ) & " people · "
			    & FORMAT ( [Seats assigned], "#,0" ) & " seats assigned · "
			    & FORMAT ( [Seats active this week], "#,0" ) & " seats active in "
			    & [Selected week label]
		lineageTag: d4e4c6b7-326e-4508-af06-189319c0cfbd

	/// Helper, not in measures.md. Amber when the tile's verdict is Not yet working, ink otherwise.
	measure 'Foundation verdict colour' = IF ( [Foundation verdict] = "Not yet working", "#B07E23", "#172529" )
		lineageTag: 221c8595-5119-438a-9ab2-15d7baaedead

	/// Helper, not in measures.md. Amber when the tile's verdict is Not yet working, ink otherwise.
	measure 'Execution verdict colour' = IF ( [Execution verdict] = "Not yet working", "#B07E23", "#172529" )
		lineageTag: fa28040a-deff-4c01-9d6c-7474e23f361b

	/// Helper, not in measures.md. Amber when the tile's verdict is Not yet working, ink otherwise.
	measure 'Refinement verdict colour' = IF ( [Refinement verdict] = "Not yet working", "#B07E23", "#172529" )
		lineageTag: 919f042d-b37f-4e42-b15a-207998015017

	/// Helper, not in measures.md. Amber when the tile's verdict is Not yet working, ink otherwise.
	measure 'Scale verdict colour' = IF ( [Scale verdict] = "Not yet working", "#B07E23", "#172529" )
		lineageTag: bd8f6299-b4b6-461a-889d-747a7c6707e8

	/// Helper, not in measures.md. The counts behind Requests matched to a tested prompt that already exists: questions pointed to library, of all questions.
	measure 'Requests matched count' =
			FORMAT ( CALCULATE ( COUNTROWS ( fact_question ), fact_question[action_taken] = "pointed to library" ) + 0, "#,0" )
			    & " of " & FORMAT ( COUNTROWS ( fact_question ) + 0, "#,0" ) & " questions"
		lineageTag: 0d4fb722-b04e-40f8-9f58-f4ae98d47ed7

	/// Helper, not in measures.md. Questions with repeat_flag true.
	measure 'Repeat-flagged questions' = CALCULATE ( COUNTROWS ( fact_question ), fact_question[repeat_flag] = TRUE () ) + 0
		formatString: #,0
		lineageTag: 3f1ce512-697f-44dd-97c3-b1073d86e02e

	/// Helper, not in measures.md. Per library item, the team other than the owner_team with the earliest run in fact_library_run; a tie goes to the team name first in alphabetical order.
	measure 'Second team' =
			VAR ownerTeam = SELECTEDVALUE ( dim_library_item[owner_team] )
			VAR otherTeams =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( fact_library_run[team] ), "@first", CALCULATE ( MIN ( fact_library_run[week_start] ) ) ),
			        fact_library_run[team] <> ownerTeam,
			        REMOVEFILTERS ( dim_team ),
			        REMOVEFILTERS ( dim_week ),
			        REMOVEFILTERS ( dim_month )
			    )
			VAR topRow = TOPN ( 1, otherTeams, [@first], ASC, fact_library_run[team], ASC )
			RETURN
			    IF ( NOT ISBLANK ( ownerTeam ), MAXX ( topRow, fact_library_run[team] ) )
		lineageTag: 14a43dde-ffe8-4e14-9b93-405dcaf674cb

	column Column1
		dataType: string
		isHidden
		lineageTag: cc560e1b-d198-477a-9c92-f0541d214040
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

