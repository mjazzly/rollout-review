	/// Helper, not in measures.md. The colour of a team-by-checkpoint cell: the team's share of people at that checkpoint, under the placement the page toggle selects, from white at none to marine (#2C5F7C) at 60% or more.
	measure 'Checkpoint shade' =
			VAR people = [People at checkpoint]
			VAR everyone = CALCULATE ( [People at checkpoint], REMOVEFILTERS ( dim_checkpoint ) )
			VAR s = MIN ( 1, DIVIDE ( people, everyone ) / 0.6 )
			VAR r = ROUND ( 255 + ( 44 - 255 ) * s, 0 )
			VAR g = ROUND ( 255 + ( 95 - 255 ) * s, 0 )
			VAR b = ROUND ( 255 + ( 124 - 255 ) * s, 0 )
			VAR h = "0123456789ABCDEF"
			RETURN
			    "#" & MID ( h, INT ( r / 16 ) + 1, 1 ) & MID ( h, MOD ( r, 16 ) + 1, 1 )
			        & MID ( h, INT ( g / 16 ) + 1, 1 ) & MID ( h, MOD ( g, 16 ) + 1, 1 )
			        & MID ( h, INT ( b / 16 ) + 1, 1 ) & MID ( h, MOD ( b, 16 ) + 1, 1 )
		lineageTag: 24a6f323-bac2-4448-b436-6fea391838e3

	/// Helper, not in measures.md. White on a cell shaded past the middle (a share of 33% or more), ink otherwise.
	measure 'Checkpoint text colour' =
