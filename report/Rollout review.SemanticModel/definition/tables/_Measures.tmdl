			VAR h = "0123456789ABCDEF"
			RETURN
			    "#" & MID ( h, INT ( r / 16 ) + 1, 1 ) & MID ( h, MOD ( r, 16 ) + 1, 1 )
			        & MID ( h, INT ( g / 16 ) + 1, 1 ) & MID ( h, MOD ( g, 16 ) + 1, 1 )
			        & MID ( h, INT ( b / 16 ) + 1, 1 ) & MID ( h, MOD ( b, 16 ) + 1, 1 )
		lineageTag: 6e88bd92-5a17-454d-9997-756dcf9cfc09

	/// Helper, not in measures.md. White on a cell with 11 or more recurring questions, ink otherwise.
	measure 'Recurring text colour' = IF ( [Repeat-flagged questions] >= 11, "#FFFFFF", "#172529" )
		lineageTag: c022fd38-7ea4-43c6-a990-e4a02502287d

	/// Helper, not in measures.md. Live library items whose latest standard-tier run is passing, and all live items, as "17 of 21 live prompts".
	measure 'Passing count' =
			VAR checkinWeek = [Check-in week]
			VAR checkinDate = [Check-in date]
			VAR liveItems =
			    FILTER (
			        dim_library_item,
			        dim_library_item[published_week] <= checkinWeek
			            && ( ISBLANK ( dim_library_item[status_week] ) || dim_library_item[status_week] > checkinWeek )
			    )
			VAR passingItems =
			    FILTER (
			        liveItems,
			        VAR itemId = dim_library_item[item_id]
			        VAR latestRun =
			            TOPN (
			                1,
			                FILTER (
			                    ALL ( fact_test_run ),
			                    fact_test_run[item_id] = itemId
			                        && fact_test_run[model_tier] = "standard"
			                        && fact_test_run[run_date] <= checkinDate
			                ),
			                fact_test_run[run_date], DESC,
			                fact_test_run[run_id], DESC
			            )
			        RETURN
			            MAXX ( latestRun, IF ( fact_test_run[passing], 1, 0 ) ) = 1
			    )
			RETURN
			    FORMAT ( COUNTROWS ( passingItems ) + 0, "#,0" ) & " of " & FORMAT ( COUNTROWS ( liveItems ) + 0, "#,0" ) & " live prompts"
		lineageTag: 7ae9159c-ce8e-442c-a6cf-250f870aa93d

	/// Helper, not in measures.md. For a live library item whose latest standard-tier run is not passing, its cases matched out of its cases, as "8 of 9 cases"; blank for every other item, so the table lists only the items not passing.
	measure 'Cases matched when not passing' =
			VAR checkinWeek = [Check-in week]
			VAR checkinDate = [Check-in date]
			VAR isLive =
			    SELECTEDVALUE ( dim_library_item[published_week] ) <= checkinWeek
			        && ( ISBLANK ( SELECTEDVALUE ( dim_library_item[status_week] ) ) || SELECTEDVALUE ( dim_library_item[status_week] ) > checkinWeek )
			VAR itemId = SELECTEDVALUE ( dim_library_item[item_id] )
			VAR latestRun =
			    TOPN (
			        1,
			        FILTER (
			            ALL ( fact_test_run ),
			            fact_test_run[item_id] = itemId
			                && fact_test_run[model_tier] = "standard"
			                && fact_test_run[run_date] <= checkinDate
			        ),
			        fact_test_run[run_date], DESC,
			        fact_test_run[run_id], DESC
			    )
			VAR matched = MAXX ( latestRun, fact_test_run[cases_matched] )
			VAR total = MAXX ( latestRun, fact_test_run[cases_total] )
			RETURN
			    IF ( HASONEVALUE ( dim_library_item[item_id] ) && isLive && NOT ISBLANK ( total ) && matched < total,
			        FORMAT ( matched, "#,0" ) & " of " & FORMAT ( total, "#,0" ) & " cases" )
		lineageTag: d9746247-1ea3-412c-a932-7e899af1fbd6

	/// Helper, not in measures.md. Check-in responses answering "I would lose time every week" over all responses, per team, for the check-in month, shown with the count as its label.
	measure 'Impact lose time share' = DIVIDE ( CALCULATE ( [Impact in people's own words], fact_checkin[q5_if_gone] = "I would lose time every week" ), [Impact in people's own words] )
		lineageTag: 22a0457c-216d-4d57-8eb9-6bd0375e801a

		formatStringDefinition = """" & FORMAT ( CALCULATE ( [Impact in people's own words], fact_checkin[q5_if_gone] = "I would lose time every week" ), "#,0" ) & """"

	/// Helper, not in measures.md. Check-in responses answering "A little" over all responses, per team, for the check-in month, shown with the count as its label.
	measure 'Impact a little share' = DIVIDE ( CALCULATE ( [Impact in people's own words], fact_checkin[q5_if_gone] = "A little" ), [Impact in people's own words] )
		lineageTag: 7fed7b0d-8740-42da-b4a7-e0be35b46860

		formatStringDefinition = """" & FORMAT ( CALCULATE ( [Impact in people's own words], fact_checkin[q5_if_gone] = "A little" ), "#,0" ) & """"

	/// Helper, not in measures.md. Check-in responses answering "Nothing" over all responses, per team, for the check-in month, shown with the count as its label.
	measure 'Impact nothing share' = DIVIDE ( CALCULATE ( [Impact in people's own words], fact_checkin[q5_if_gone] = "Nothing" ), [Impact in people's own words] )
		lineageTag: 9015c75a-1760-4d17-b34d-54afa354bf3a

		formatStringDefinition = """" & FORMAT ( CALCULATE ( [Impact in people's own words], fact_checkin[q5_if_gone] = "Nothing" ), "#,0" ) & """"

	/// Helper, not in measures.md. Share of people in the air latest minus Share of people in the air baseline, in points.
	measure 'Air change points' = ( [Share of people in the air latest] - [Share of people in the air baseline] ) * 100
		formatString: +0.0;-0.0;0.0
		lineageTag: 19bf924e-3fed-4a50-8b5c-bce9f5ca14b2

	/// Helper, not in measures.md. Library items with runs from two or more teams, and all library items, as "4 of 23 library items".
	measure 'Uses taken up count' = FORMAT ( [Uses taken up beyond the first team], "#,0" ) & " of " & FORMAT ( COUNTROWS ( ALL ( dim_library_item ) ), "#,0" ) & " library items"
		lineageTag: 52a9aa68-4271-4b15-8e94-f2602569fc01

	/// Helper, not in measures.md. Week the second team started as words, as "Week 7"; blank when no second team.
	measure 'Second team from' =
			VAR w = [Week the second team started]
			RETURN
			    IF ( NOT ISBLANK ( w ), "Week " & w )
		lineageTag: be2de9ee-097c-4d35-ba93-d9762c5d92c3

	/// Helper, not in measures.md. People at checkpoint, for a named team and checkpoint only.
	measure 'People at checkpoint in grid' =
			IF (
			    NOT ISBLANK ( SELECTEDVALUE ( dim_team[team] ) ) && NOT ISBLANK ( SELECTEDVALUE ( dim_checkpoint[checkpoint] ) ),
			    [People at checkpoint]
			)
		formatString: #,0
		lineageTag: d969b4bc-62f1-43a7-962c-670cff34782d

	/// Helper, not in measures.md. Questions with repeat_flag true, for a named use and month only.
	measure 'Recurring questions in grid' =
			IF (
			    NOT ISBLANK ( SELECTEDVALUE ( dim_category[category] ) ) && NOT ISBLANK ( SELECTEDVALUE ( dim_month[month_label] ) ),
			    [Repeat-flagged questions]
			)
		formatString: #,0
		lineageTag: d77b4de8-ee6e-4bb2-bef4-45340e045165

	/// Helper, not in measures.md. The front page's Refinement figure in words, as "9.5% of live prompts at Week 24".
	measure 'Smaller model share line' = FORMAT ( [Refinement tile], "0.0%" ) & " of live prompts at Week 24"
		lineageTag: 9435761b-13ce-4263-92c0-35b5256c830d

	/// Helper, not in measures.md. For a library item whose latest smaller-tier run is passing, its cases matched out of its cases, as "11 of 11 cases"; blank for every other item, so the table lists only the items passing.
	measure 'Smaller model cases when passing' =
			VAR itemId = SELECTEDVALUE ( dim_library_item[item_id] )
			VAR latestRun =
			    TOPN (
			        1,
			        FILTER ( ALL ( fact_test_run ), fact_test_run[item_id] = itemId && fact_test_run[model_tier] = "smaller" ),
			        fact_test_run[run_date], DESC,
			        fact_test_run[run_id], DESC
			    )
			VAR matched = MAXX ( latestRun, fact_test_run[cases_matched] )
			VAR total = MAXX ( latestRun, fact_test_run[cases_total] )
			RETURN
			    IF ( NOT ISBLANK ( itemId ) && NOT ISBLANK ( total ) && matched = total,
			        FORMAT ( matched, "#,0" ) & " of " & FORMAT ( total, "#,0" ) & " cases" )
		lineageTag: 76c9075e-e4e8-4d93-9269-bd36442dee62

	/// Helper, not in measures.md. For a retired or merged library item, what happened and in which check-in month, as "Merged into LIB-10 in Month 5"; blank for every other item.
	measure 'Retired or merged change' =
			VAR st = SELECTEDVALUE ( dim_library_item[status] )
			VAR m = SELECTEDVALUE ( dim_library_item[status_month] )
			VAR intoItem = SELECTEDVALUE ( dim_library_item[merged_into_item_id] )
			RETURN
			    SWITCH ( st, "retired", "Retired in Month " & m, "merged", "Merged into " & intoItem & " in Month " & m )
		lineageTag: b0a8bb29-73f2-4e34-94f8-2f382fe913bb

