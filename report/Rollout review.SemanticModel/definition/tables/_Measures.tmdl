		lineageTag: f3601fe6-230a-4b0b-a39a-114bbb63870e

	/// The trend compares the figure for the check-in month with the figure for two check-in months earlier. It is Flat when the two are within 1 percentage point of each other, Up when the figure is higher by more than that, and Down when it is lower by more than that. When there is no figure for two check-in months earlier, the trend is No comparison yet.
	measure 'Foundation trend' =
			VAR m = [Check-in month]
			VAR figure = [Foundation tile]
			VAR twoEarlier =
			    IF ( m >= 3, CALCULATE ( [Foundation tile], REMOVEFILTERS ( dim_month ), dim_month[checkin_month] = m - 2 ) )
			VAR pointsDiff = ( figure - twoEarlier ) * 100
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( figure ), BLANK (),
			        ISBLANK ( twoEarlier ), "No comparison yet",
			        ABS ( pointsDiff ) <= 1, "→ Flat",
			        pointsDiff > 0, "↑ Up",
			        "↓ Down"
			    )
		lineageTag: bef086b7-877d-4cfb-b823-2c69bd70315f

	/// The trend compares the figure for the check-in month with the figure for two check-in months earlier. It is Flat when the two are within 1 percentage point of each other, Up when the figure is higher by more than that, and Down when it is lower by more than that. When there is no figure for two check-in months earlier, the trend is No comparison yet.
	measure 'Execution trend' =
			VAR m = [Check-in month]
			VAR figure = [Execution tile]
			VAR twoEarlier =
			    IF ( m >= 3, CALCULATE ( [Execution tile], REMOVEFILTERS ( dim_month ), dim_month[checkin_month] = m - 2 ) )
			VAR pointsDiff = ( figure - twoEarlier ) * 100
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( figure ), BLANK (),
			        ISBLANK ( twoEarlier ), "No comparison yet",
			        ABS ( pointsDiff ) <= 1, "→ Flat",
			        pointsDiff > 0, "↑ Up",
			        "↓ Down"
			    )
		lineageTag: 699c68a6-cbf0-46ab-bf3b-daa72f257b72

	/// The trend compares the figure for the check-in month with the figure for two check-in months earlier. It is Flat when the two are within 1 percentage point of each other, Up when the figure is higher by more than that, and Down when it is lower by more than that. When there is no figure for two check-in months earlier, the trend is No comparison yet.
	measure 'Refinement trend' =
