table _Measures
	lineageTag: 68146057-20ef-42be-b1d5-f386c0081eeb

	/// Helper, not in measures.md. The check-in month in the filter context: the latest month selected, or month 6 when no month is selected.
	measure 'Check-in month' = MAX ( dim_month[checkin_month] )
		formatString: 0
		lineageTag: 7b462fcd-0f5f-4023-9343-e874b36be1ff

	/// The fourth and last week of a check-in month. The check-in date is the last day of that week.
	measure 'Check-in week' = MAX ( dim_month[checkin_week] )
		formatString: yyyy-mm-dd
		lineageTag: 34448344-ef57-49be-9784-1a8c729c7e3d

	/// The fourth and last week of a check-in month. The check-in date is the last day of that week.
	measure 'Check-in date' = MAX ( dim_month[checkin_date] )
		formatString: yyyy-mm-dd
		lineageTag: 824e6192-92af-454f-889d-5e14d365e896

	/// People whose seat_assigned_week is on or before the week.
	measure 'Assigned seats' =
			VAR wk = MAX ( dim_week[week_start] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( dim_person ),
			        KEEPFILTERS (
			            NOT ISBLANK ( dim_person[seat_assigned_week] )
			                && dim_person[seat_assigned_week] <= wk
			        )
			    ) + 0
		formatString: #,0
		lineageTag: b3123b33-39cf-4b55-a72e-aaddcc5ecd69

	/// People with days_active of 2 or more in the week, over assigned seats.
	measure 'Weekly active share' =
			VAR wk = MAX ( dim_week[week_start] )
			VAR active =
			    CALCULATE (
			        COUNTROWS ( fact_usage_week ),
			        fact_usage_week[days_active] >= 2,
			        dim_week[week_start] = wk
			    )
			RETURN
			    DIVIDE ( active + 0, [Assigned seats] )
		formatString: 0.0%
		lineageTag: 41ce46fa-9564-4ca8-b8e5-2b9d6fbceba9

	/// runs_via_library over runs_total.
	measure 'Library share' = DIVIDE ( SUM ( fact_usage_week[runs_via_library] ), SUM ( fact_usage_week[runs_total] ) )
		formatString: 0.0%
		lineageTag: bd2d3d56-c405-41ce-aab2-ea2eb4ecc2ad

	/// Median tokens per run on the standard tier over median tokens per run on the smaller tier, per item.
	measure 'Cost index' =
			IF (
			    HASONEVALUE ( dim_library_item[item_id] ),
			    VAR standardMedian =
			        CALCULATE ( MEDIAN ( fact_test_run[tokens_per_run] ), fact_test_run[model_tier] = "standard" )
			    VAR smallerMedian =
			        CALCULATE ( MEDIAN ( fact_test_run[tokens_per_run] ), fact_test_run[model_tier] = "smaller" )
			    RETURN
			        DIVIDE ( standardMedian, smallerMedian )
			)
		formatString: 0.00
		lineageTag: 5dc06001-7437-4825-9120-7c5cab5d81eb

	/// People who held a seat at both the latest count and the previous count, and whose source checkpoint_id at the latest count is higher than at the previous count.
	measure 'Moved up' =
			VAR m = [Check-in month]
			VAR previousWeek =
			    CALCULATE ( MAX ( dim_month[checkin_week] ), REMOVEFILTERS ( dim_month ), dim_month[checkin_month] = m - 1 )
			VAR seatedAtBoth =
			    FILTER (
			        dim_person,
			        NOT ISBLANK ( dim_person[seat_assigned_week] )
			            && dim_person[seat_assigned_week] <= previousWeek
			    )
			VAR movedUp =
			    FILTER (
			        seatedAtBoth,
			        VAR latest =
			            CALCULATE ( MAX ( fact_placement[source_checkpoint_id] ), REMOVEFILTERS ( dim_month ), fact_placement[checkin_month] = m )
			        VAR previous =
			            CALCULATE ( MAX ( fact_placement[source_checkpoint_id] ), REMOVEFILTERS ( dim_month ), fact_placement[checkin_month] = m - 1 )
			        RETURN
			            latest > previous
			    )
			RETURN
			    IF ( m >= 2, COUNTROWS ( movedUp ) + 0 )
		formatString: #,0
		lineageTag: 707b8eeb-bd0f-4f90-85dd-6a3a5193d300

	/// People with no seat at the previous count and a seat at the latest count. Always shown beside Moved up and never added into it.
	measure 'Seats arrived' =
			VAR m = [Check-in month]
			VAR previousWeek =
			    CALCULATE ( MAX ( dim_month[checkin_week] ), REMOVEFILTERS ( dim_month ), dim_month[checkin_month] = m - 1 )
			VAR latestWeek =
			    CALCULATE ( MAX ( dim_month[checkin_week] ), REMOVEFILTERS ( dim_month ), dim_month[checkin_month] = m )
			VAR arrived =
			    FILTER (
			        dim_person,
			        NOT ISBLANK ( dim_person[seat_assigned_week] )
			            && dim_person[seat_assigned_week] > previousWeek
			            && dim_person[seat_assigned_week] <= latestWeek
			    )
			RETURN
			    IF ( m >= 2, COUNTROWS ( arrived ) + 0 )
		formatString: #,0
		lineageTag: 512accd9-34e0-42bb-ac38-7f0e46de4741

	/// People in dim_person.
	measure Headcount = COUNTROWS ( dim_person )
		formatString: #,0
		lineageTag: a776e53f-2825-4cc7-8988-9c99ab12bd57

	/// Assigned seats in the selected week.
	measure 'Seats assigned' = [Assigned seats]
		formatString: #,0
		lineageTag: ca973877-e732-49f3-974a-84fa54ee45a7

	/// People with an assigned seat and days_active of 2 or more in the selected week.
	measure 'Seats active this week' =
			VAR wk = MAX ( dim_week[week_start] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_usage_week ),
			        fact_usage_week[days_active] >= 2,
			        dim_week[week_start] = wk,
			        KEEPFILTERS (
			            NOT ISBLANK ( dim_person[seat_assigned_week] )
			                && dim_person[seat_assigned_week] <= wk
			        )
			    ) + 0
		formatString: #,0
		lineageTag: 119f518a-a420-46f0-894e-fc77a36fabfd

	/// Share of people in each stage (On the ground, At the gate, In the air) by source placement, for the latest check-in month and for the baseline, with each team taken at its own baseline month.
	measure 'Stage split latest' =
			VAR m = [Check-in month]
			VAR inStage =
			    CALCULATE ( COUNTROWS ( fact_placement ), REMOVEFILTERS ( dim_month ), fact_placement[checkin_month] = m )
			VAR everyone =
			    CALCULATE (
			        COUNTROWS ( fact_placement ),
			        REMOVEFILTERS ( dim_month ),
			        fact_placement[checkin_month] = m,
			        REMOVEFILTERS ( dim_checkpoint_source )
			    )
			RETURN
			    DIVIDE ( inStage + 0, everyone )
		formatString: 0.0%
		lineageTag: 5a6828ca-1c91-4ecd-b0c4-b761e71b4ac6

	/// Share of people in each stage (On the ground, At the gate, In the air) by source placement, for the latest check-in month and for the baseline, with each team taken at its own baseline month.
	measure 'Stage split baseline' =
			VAR inStage =
			    SUMX (
			        VALUES ( dim_team[team] ),
			        VAR b = CALCULATE ( MAX ( dim_team[baseline_month] ) )
			        RETURN
			            CALCULATE ( COUNTROWS ( fact_placement ), REMOVEFILTERS ( dim_month ), fact_placement[checkin_month] = b )
			    )
			VAR everyone =
			    SUMX (
			        VALUES ( dim_team[team] ),
			        VAR b = CALCULATE ( MAX ( dim_team[baseline_month] ) )
			        RETURN
			            CALCULATE (
			                COUNTROWS ( fact_placement ),
			                REMOVEFILTERS ( dim_month ),
			                fact_placement[checkin_month] = b,
			                REMOVEFILTERS ( dim_checkpoint_source )
			            )
			    )
			RETURN
			    DIVIDE ( inStage + 0, everyone )
		formatString: 0.0%
		lineageTag: 91d24c91-ee6b-4ae5-abd4-5741d454190a

	/// Moved up, counted between the latest check-in month and the one before it, shown with Seats arrived for the same two counts beside it.
	measure 'Moved up since last count' = [Moved up]
		formatString: #,0
		lineageTag: c71ae209-a6cc-467c-9244-8ca0ad49b4d5

	/// Questions asked in the check-in month with action_taken of pointed to library, over all questions asked in the check-in month.
	measure 'Foundation tile' =
			VAR m = [Check-in month]
			RETURN
			    CALCULATE (
			        DIVIDE (
			            CALCULATE ( COUNTROWS ( fact_question ), fact_question[action_taken] = "pointed to library" ) + 0,
			            COUNTROWS ( fact_question )
			        ),
			        REMOVEFILTERS ( dim_month ),
			        REMOVEFILTERS ( dim_week ),
			        dim_month[checkin_month] = m
			    )
		formatString: 0.0%
		lineageTag: 09820dd5-68c1-4b6f-9e5c-b957c6546b84

	/// People with another active week starting within 30 days after their first active week, over people whose first active week starts at least 30 days before the check-in date.
	measure 'Execution tile' =
			VAR checkinDate = [Check-in date]
			VAR firstWeeks =
			    ADDCOLUMNS (
			        VALUES ( dim_person[person_id] ),
			        "@first",
			            CALCULATE (
			                MIN ( fact_usage_week[week_start] ),
			                fact_usage_week[days_active] >= 2,
			                REMOVEFILTERS ( dim_week ),
			                REMOVEFILTERS ( dim_month )
			            )
			    )
			VAR eligible =
			    FILTER ( firstWeeks, NOT ISBLANK ( [@first] ) && [@first] <= checkinDate - 30 )
			VAR repeated =
			    FILTER (
			        eligible,
			        VAR firstWeek = [@first]
			        RETURN
			            CALCULATE (
			                COUNTROWS ( fact_usage_week ),
			                fact_usage_week[days_active] >= 2,
			                fact_usage_week[week_start] > firstWeek,
			                fact_usage_week[week_start] <= firstWeek + 30,
			                REMOVEFILTERS ( dim_week ),
			                REMOVEFILTERS ( dim_month )
			            ) > 0
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( repeated ) + 0, COUNTROWS ( eligible ) )
		formatString: 0.0%
		lineageTag: 8a375470-efbe-4f3e-8030-05203598a16c

	/// Items live in the check-in week whose latest smaller-tier run on or before the check-in date is passing, over all items live in the check-in week.
	measure 'Refinement tile' =
			VAR checkinWeek = [Check-in week]
			VAR checkinDate = [Check-in date]
			VAR liveItems =
			    FILTER (
			        dim_library_item,
			        dim_library_item[published_week] <= checkinWeek
			            && ( ISBLANK ( dim_library_item[status_week] ) || dim_library_item[status_week] > checkinWeek )
			    )
			VAR passingItems =
			    FILTER (
			        liveItems,
			        VAR itemId = dim_library_item[item_id]
			        VAR latestRun =
			            TOPN (
			                1,
			                FILTER (
			                    ALL ( fact_test_run ),
			                    fact_test_run[item_id] = itemId
			                        && fact_test_run[model_tier] = "smaller"
			                        && fact_test_run[run_date] <= checkinDate
			                ),
			                fact_test_run[run_date], DESC,
			                fact_test_run[run_id], DESC
			            )
			        RETURN
			            MAXX ( latestRun, IF ( fact_test_run[passing], 1, 0 ) ) = 1
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( passingItems ) + 0, COUNTROWS ( liveItems ) )
		formatString: 0.0%
		lineageTag: 82e7064d-6696-41a9-9c1e-659d08fd23e6

	/// Share of people with a source checkpoint_id of 7, 8 or 9 in the check-in month, minus the same people's share at their team's baseline month, in percentage points. Only teams whose baseline month is on or before the check-in month count. Before any team reaches its baseline month, the tile has no figure.
	measure 'Scale tile' =
			VAR m = [Check-in month]
			VAR teamsCounted =
			    FILTER (
			        VALUES ( dim_team[team] ),
			        VAR b = CALCULATE ( MAX ( dim_team[baseline_month] ) )
			        RETURN
			            NOT ISBLANK ( b ) && b <= m
			    )
			VAR people = CALCULATE ( COUNTROWS ( dim_person ), teamsCounted )
			VAR airNow =
			    CALCULATE (
			        COUNTROWS ( fact_placement ),
			        teamsCounted,
			        fact_placement[source_checkpoint_id] >= 7,
			        REMOVEFILTERS ( dim_month ),
			        fact_placement[checkin_month] = m
			    )
			VAR airAtBaseline =
			    SUMX (
			        teamsCounted,
			        VAR b = CALCULATE ( MAX ( dim_team[baseline_month] ) )
			        RETURN
			            CALCULATE (
			                COUNTROWS ( fact_placement ),
			                fact_placement[source_checkpoint_id] >= 7,
			                REMOVEFILTERS ( dim_month ),
			                fact_placement[checkin_month] = b
			            )
			    )
			RETURN
			    IF ( people > 0, ( DIVIDE ( airNow + 0, people ) - DIVIDE ( airAtBaseline + 0, people ) ) * 100 )
		formatString: +0.0;-0.0;0.0
		lineageTag: e9aa28d3-8e61-4fe9-aaac-f9ca1a7b08b6

	/// The verdict is Working when the figure for the check-in month meets the tile's threshold, and Not yet working when it does not. Trend plays no part in it.
	measure 'Foundation verdict' =
			VAR figure = [Foundation tile]
			VAR threshold = CALCULATE ( MAX ( dim_threshold[threshold] ), dim_threshold[stage] = "Foundation" )
			RETURN
			    IF ( NOT ISBLANK ( figure ), IF ( figure >= threshold, "Working", "Not yet working" ) )
		lineageTag: 63aac9d0-7e0a-4f85-a704-5cc55b262619

	/// The verdict is Working when the figure for the check-in month meets the tile's threshold, and Not yet working when it does not. Trend plays no part in it.
	measure 'Execution verdict' =
			VAR figure = [Execution tile]
			VAR threshold = CALCULATE ( MAX ( dim_threshold[threshold] ), dim_threshold[stage] = "Execution" )
			RETURN
			    IF ( NOT ISBLANK ( figure ), IF ( figure >= threshold, "Working", "Not yet working" ) )
		lineageTag: 360df7d9-7579-4954-8368-ef47d826569c

	/// The verdict is Working when the figure for the check-in month meets the tile's threshold, and Not yet working when it does not. Trend plays no part in it.
	measure 'Refinement verdict' =
			VAR figure = [Refinement tile]
			VAR threshold = CALCULATE ( MAX ( dim_threshold[threshold] ), dim_threshold[stage] = "Refinement" )
			RETURN
			    IF ( NOT ISBLANK ( figure ), IF ( figure >= threshold, "Working", "Not yet working" ) )
		lineageTag: 344c27c7-f375-4286-9dcc-881e6ea42315

	/// The verdict is Working when the figure for the check-in month meets the tile's threshold, and Not yet working when it does not. Trend plays no part in it.
	measure 'Scale verdict' =
			VAR figure = [Scale tile]
			VAR threshold = CALCULATE ( MAX ( dim_threshold[threshold] ), dim_threshold[stage] = "Scale" )
			RETURN
