	/// Weekly active share per team, averaged over the four weeks starting with the week the team's seats arrive.
	measure 'Usage baseline by team' =
			IF (
			    HASONEVALUE ( dim_team[team] ),
			    VAR firstWeek = SELECTEDVALUE ( dim_team[seats_arrive_week] )
			    VAR baselineWeeks =
			        CALCULATETABLE (
			            VALUES ( dim_week[week_start] ),
			            REMOVEFILTERS ( dim_month ),
			            REMOVEFILTERS ( dim_week ),
			            dim_week[week_start] >= firstWeek,
			            dim_week[week_start] <= firstWeek + 21
			        )
			    RETURN
			        AVERAGEX (
			            baselineWeeks,
			            VAR wk = dim_week[week_start]
			            RETURN
			                CALCULATE (
			                    [Weekly active share],
			                    REMOVEFILTERS ( dim_month ),
			                    REMOVEFILTERS ( dim_week ),
			                    dim_week[week_start] = wk
			                )
			        )
			)
		formatString: 0.0%
		lineageTag: 317ce7cf-2eef-4e1d-9b98-a20ccc874627

	/// Training attendees with a run of the item shown in their session in the session week or the week after, over all training attendees.
	measure 'First use within two weeks of training' =
			VAR ranShownItem =
			    FILTER (
			        fact_training,
			        VAR personId = fact_training[person_id]
			        VAR itemId = fact_training[item_id_shown]
			        VAR sessionWeek = fact_training[session_week]
			        RETURN
			            CALCULATE (
			                COUNTROWS ( fact_library_run_person ),
			                REMOVEFILTERS ( dim_week ),
			                REMOVEFILTERS ( dim_month ),
			                fact_library_run_person[person_id] = personId,
			                fact_library_run_person[item_id] = itemId,
			                fact_library_run_person[week_start] >= sessionWeek,
			                fact_library_run_person[week_start] <= sessionWeek + 7
			            ) > 0
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( ranShownItem ) + 0, COUNTROWS ( fact_training ) )
		formatString: 0.0%
		lineageTag: c4ddc6f7-1366-4c55-b33d-2ac8eeb4fa48

	/// People with another active week starting within 30 days after their first active week, over people whose first active week starts at least 30 days before the end of the period.
	measure 'Repeat use within 30 days' =
			VAR lastMonth = CALCULATE ( MAX ( dim_month[checkin_month] ), REMOVEFILTERS ( dim_month ) )
			RETURN
			    CALCULATE ( [Execution tile], REMOVEFILTERS ( dim_month ), dim_month[checkin_month] = lastMonth )
		formatString: 0.0%
		lineageTag: b3385a19-ae67-4c71-a3ba-28f7f33c905c

	/// Questions with repeat_flag true whose category had a live library item in the week they were asked, over all questions with repeat_flag true.
	measure 'Recurring questions covered by a tested prompt' =
			VAR repeatQuestions = FILTER ( fact_question, fact_question[repeat_flag] )
			VAR covered =
			    FILTER (
			        repeatQuestions,
			        VAR questionCategory = fact_question[category]
			        VAR askedWeek = fact_question[question_week]
			        RETURN
			            NOT ISEMPTY (
			                FILTER (
			                    ALL ( dim_library_item ),
			                    dim_library_item[category] = questionCategory
			                        && dim_library_item[published_week] <= askedWeek
			                        && ( ISBLANK ( dim_library_item[status_week] ) || dim_library_item[status_week] > askedWeek )
			                )
			            )
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( covered ) + 0, COUNTROWS ( repeatQuestions ) )
		formatString: 0.0%
		lineageTag: e247c410-12a2-478e-ac0c-4874cae7e1f2

	/// Live library items whose latest standard-tier run is passing, over all live library items.
	measure 'Tested prompts passing their cases' =
			VAR checkinWeek = [Check-in week]
			VAR checkinDate = [Check-in date]
			VAR liveItems =
			    FILTER (
			        dim_library_item,
			        dim_library_item[published_week] <= checkinWeek
			            && ( ISBLANK ( dim_library_item[status_week] ) || dim_library_item[status_week] > checkinWeek )
			    )
			VAR passingItems =
			    FILTER (
			        liveItems,
			        VAR itemId = dim_library_item[item_id]
			        VAR latestRun =
			            TOPN (
			                1,
			                FILTER (
			                    ALL ( fact_test_run ),
			                    fact_test_run[item_id] = itemId
			                        && fact_test_run[model_tier] = "standard"
			                        && fact_test_run[run_date] <= checkinDate
			                ),
			                fact_test_run[run_date], DESC,
			                fact_test_run[run_id], DESC
			            )
			        RETURN
			            MAXX ( latestRun, IF ( fact_test_run[passing], 1, 0 ) ) = 1
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( passingItems ) + 0, COUNTROWS ( liveItems ) )
		formatString: 0.0%
		lineageTag: f4e126c5-2b2a-4e3d-8e26-90bb35c2e805

	/// Library items whose latest smaller-tier run is passing.
	measure 'Tested prompts that pass on a smaller model' =
			VAR passingItems =
			    FILTER (
			        dim_library_item,
			        VAR itemId = dim_library_item[item_id]
			        VAR latestRun =
			            TOPN (
			                1,
			                FILTER ( ALL ( fact_test_run ), fact_test_run[item_id] = itemId && fact_test_run[model_tier] = "smaller" ),
			                fact_test_run[run_date], DESC,
			                fact_test_run[run_id], DESC
			            )
			        RETURN
			            MAXX ( latestRun, IF ( fact_test_run[passing], 1, 0 ) ) = 1
			    )
			RETURN
			    COUNTROWS ( passingItems ) + 0
		formatString: #,0
		lineageTag: 402a187e-15fc-42a7-b4f2-082f3ddc207e

	/// Median tokens per run, per item and model tier.
	measure 'Cost per use' = MEDIAN ( fact_test_run[tokens_per_run] )
