	/// Helper, not in measures.md. Whether the question was pointed to the library, as "Matched to a tested prompt" or "Not matched", for the page 2 ranking.
	column match_label = IF ( fact_question[action_taken] = "pointed to library", "Matched to a tested prompt", "Not matched" )
		lineageTag: 93f800ff-1b39-40dc-bcff-477cd07e13fd
		summarizeBy: none

	partition fact_question = m
		mode: import
		source =
				let
				    Source = LoadCsv("fact_question"),
				    Typed = Table.TransformColumnTypes(Source, {
				        {"question_id", type text}, {"question_date", type date}, {"person_id", type text},
				        {"team", type text}, {"category", type text}, {"difficulty", Int64.Type},
				        {"action_taken", type text}, {"linked_item_id", type text},
				        {"answered_by_person_id", type text}, {"repeat_flag", type logical}
				    }, "en-US"),
				    QuestionWeek = Table.AddColumn(Typed, "question_week", each Date.StartOfWeek([question_date], Day.Monday), type date)
				in
				    QuestionWeek

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

