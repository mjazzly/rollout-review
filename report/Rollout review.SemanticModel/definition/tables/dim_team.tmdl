table dim_team
	lineageTag: 304791f7-bbed-4e46-8aea-4875e2c9491a

	column team
		dataType: string
		lineageTag: d1a48a42-2351-4df2-920f-3987762a0a8d
		summarizeBy: none
		sourceColumn: team

		annotation SummarizationSetBy = Automatic

	column headcount
		dataType: int64
		formatString: 0
		lineageTag: caf28b59-3c4c-42fa-93dd-ae70c1e57a83
		summarizeBy: sum
		sourceColumn: headcount

		annotation SummarizationSetBy = Automatic

	/// Helper, not in measures.md. The team with its baseline month, as "Consulting · Month 3", for the page 5 axis.
	column team_baseline_label =
			dim_team[team] & " · Month " & dim_team[baseline_month]
		dataType: string
		isDataTypeInferred
		summarizeBy: none

	/// The earliest seat_assigned_week among the team's people.
	column seats_arrive_week =
			CALCULATE ( MIN ( dim_person[seat_assigned_week] ) )
		dataType: dateTime
		isDataTypeInferred
		summarizeBy: none
		formatString: yyyy-mm-dd

	/// For each team, the first check-in month whose trailing eight weeks start on or after the week the team's seats arrive.
	column baseline_month =
			VAR arrivalWeekNo =
			    LOOKUPVALUE ( dim_week[week_no], dim_week[week_start], dim_team[seats_arrive_week] )
			VAR firstMonth = ROUNDUP ( ( arrivalWeekNo + 7 ) / 4, 0 )
			RETURN
			    IF ( NOT ISBLANK ( arrivalWeekNo ) && firstMonth <= 6, firstMonth )
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		formatString: 0

	partition dim_team = m
		mode: import
		source =
				let
				    Source = LoadCsv("dim_team"),
				    Typed = Table.TransformColumnTypes(Source, {{"team", type text}, {"headcount", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
