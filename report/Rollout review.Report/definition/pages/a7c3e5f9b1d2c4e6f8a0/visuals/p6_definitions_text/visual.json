  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Requests matched to a tested prompt that already exists. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Questions answered by pointing the asker to a prompt in the library, over all questions logged.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Repeat use within 30 days. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "People active again within 30 days of their first active week, over people whose first active week began at least 30 days before the check-in.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Tested prompts that pass on a smaller model. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Prompts whose latest run on the smaller model matched every test case. The front page shows them as a share of the prompts live at the check-in.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Share of people in the air against the baseline. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "People the sources place at Takeoff, Above the clouds or Frequent flyer, as a share of the team, at Month 6 against the team's baseline month: the first check-in after its seats arrived. The change is in points.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "People at each checkpoint. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "People at each of the nine checkpoints in the month picked, by their own check-in answer or by what the sources show.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The gap. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Each person's check-in checkpoint against their source checkpoint: higher, level or lower.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Moved up, and movement. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "People seated at both counts whose source checkpoint rose, held or fell between the previous count and this one. Seats arrived over the same month are counted apart, never added in.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Largest group. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "The checkpoint holding the most people in each team, with the lever written for it. A tie goes to the earlier checkpoint.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Uses logged and ranked. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Questions in the question log, by use. Matched means the asker was pointed to a tested prompt.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Prompts tested against an answer key written first. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Prompts whose answer key was written before they were tested, over all prompts in the library.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Usage baseline by team. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "The team's weekly active share, averaged over the four weeks from the week its seats arrived.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "First use within two weeks of training. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Attendees who ran the prompt shown in their session that week or the next, over all attendees.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Recurring questions covered by a tested prompt. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Questions marked as recurring whose use had a live prompt in the library the week they were asked, over all recurring questions.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Tested prompts passing their cases. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Prompts live at the check-in whose latest run on the standard model matched every test case, over all live prompts.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cost per use and the cost index. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Median tokens per test run on each model. The cost index is the standard model's median over the smaller model's.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Prompts retired or merged. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Prompts retired or merged into another, counted in the check-in month of the change.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Impact in people's own words. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Answers at the Month 6 check-in to \"If AI disappeared from your work tomorrow, what would change?\", by team.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Uses taken up beyond the first team. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Prompts run by two or more teams, and the week a team other than the one that made it first ran each.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              }
            ]
          }
        }
