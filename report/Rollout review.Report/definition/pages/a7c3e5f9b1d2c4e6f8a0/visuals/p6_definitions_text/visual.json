              {
                "textRuns": [
                  {
                    "value": "Rollout review. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "The four stage figures are defined under their pages; moved up is under Where people sit.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Where people sit",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#2C5F7C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "People at each checkpoint. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "People at each of the nine checkpoints in the month picked, by their own check-in answer or by what the sources show.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The gap. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Each person's check-in checkpoint against their source checkpoint: higher, level or lower.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Moved up, and movement. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "People seated at both counts whose source checkpoint rose, held or fell since the previous count; seats arrived in the month are counted apart.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Largest group. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "The checkpoint holding the most people in each team, with the lever written for it; a tie goes to the earlier checkpoint.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Foundation",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#2C5F7C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Uses logged and ranked. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Questions in the question log, by use; matched means the asker was pointed to a tested prompt.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Requests matched to a tested prompt that already exists. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Questions answered by pointing the asker to a prompt in the library, over all questions logged.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4F6166"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Prompts tested against an answer key written first. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontWeight": "bold",
                      "color": "#172529"
                    }
                  },
                  {
                    "value": "Prompts whose answer key was written before they were tested, over all prompts in the library.",
